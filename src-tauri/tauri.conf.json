{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "icnana",
  "version": "1.1.0",
  "identifier": "com.icnana",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "icnana",
        "width": 800,
        "height": 600,
        "decorations": false,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/testlib/*",
      "resources/toolchain/**/*"
    ],
    "linux": {
      "deb": {
        "depends": [
          "g++"
        ]
      },
      "rpm": {
        "depends": [
          "gcc-c++"
        ]
      }
    }
  }
}
